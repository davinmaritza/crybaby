[Unit]
Description=Crybaby Distributed Cluster Controller
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=suzirz
Group=suzirz
WorkingDirectory=/home/suzirz/Documents/crybaby
ExecStart=/home/suzirz/Documents/crybaby/bin/crybaby-controller -port 8080 -password crybaby123
Restart=always
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
